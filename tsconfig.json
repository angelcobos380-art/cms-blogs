{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@app/*": ["src/app/*"],
      "@core/*": ["src/core/*"],
      "@shared/*": ["src/shared/*"],
      "@dashboard": ["src/modules/dashboard/index.ts"],
      "@dashboard/*": ["src/modules/dashboard/*"],
      "@blogs": ["src/modules/blogs/index.ts"],
      "@blogs/*": ["src/modules/blogs/*"],
      "@templates": ["src/modules/templates/index.ts"],
      "@templates/*": ["src/modules/templates/*"]
    }
  },
  "include": ["src"]
}
